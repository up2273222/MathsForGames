#pragma kernel InitialiseAttractorPoints
#pragma kernel IterateCurrentPoints
#pragma kernel CullInvisibleInstances
#pragma kernel resetInstanceCount

#include "MathCore.cginc"

struct FrustumPlane{
    float3 normal;
    float distance;
};


RWStructuredBuffer<float3> _CurrentPoints;
RWStructuredBuffer<float3> _VisiblePoints;

RWStructuredBuffer<uint> _ArgsBuffer;

RWStructuredBuffer<FrustumPlane> _FrustumPlanesBuffer;

RWStructuredBuffer<MathCoreM4x4> _AttractorMatrices;


uint particleCount;
int affineTransformationCount;


int currentFrame;





float hash(uint n) {
   // integer hash copied from Hugo Elias
   n = (n << 13U) ^ n;
   n = n * (n * n * 15731U + 0x789221U) + 0x1376312589U;
   return float(n & uint(0x7fffffffU)) / float(0x7fffffff);
}

[numthreads(256,1,1)]
void InitialiseAttractorPoints(uint3 id : SV_DispatchThreadID)
{
    uint rng = id.x * 6546456 + currentFrame * 12356;

    float3 pos = float3(
    hash(rng) * 2 - 1,
    hash(rng) * 2 - 1,
    0);
 
    _CurrentPoints[id.x] = pos;
}


[numthreads(256,1,1)]
void IterateCurrentPoints(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= particleCount) {return;}
    float3 pos = _CurrentPoints[id.x];
    
    uint seed = id.x;
    for (int i = 0; i < 20; i++)
    {
        seed += i * 1926783;
        float r = hash(seed);
    
        uint index = (uint)(r * affineTransformationCount);
        pos = MathCoreMul(_AttractorMatrices[index],float4(pos,1)).xyz;
    }
    _CurrentPoints[id.x] = pos;
}

[numthreads(256,1,1)]
void CullInvisibleInstances(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= particleCount) {return;}
    float3 pos = _CurrentPoints[id.x];
    
    for (int i = 0; i < 6; i++)
    {
        float ndotplusd = (dot(pos, _FrustumPlanesBuffer[i].normal) + _FrustumPlanesBuffer[i].distance);
        if (ndotplusd < 0.0f)
        {
        return;
        }
    }
    
    uint writeIndex;
    InterlockedAdd(_ArgsBuffer[1],(uint)1,writeIndex);
    _VisiblePoints[writeIndex] = pos;
}




[numthreads(1,1,1)]
void resetInstanceCount (uint3 id : SV_DispatchThreadID)
{
    _ArgsBuffer[1] = 0;
}


